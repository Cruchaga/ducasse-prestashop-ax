<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <!-- La consola corre sobre el runtime 4 si la máquina no tiene .NET 3.5 instalado (la DLL sigue siendo 3.5). -->
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.0" />
    <supportedRuntime version="v2.0.50727" />
  </startup>
</configuration>
